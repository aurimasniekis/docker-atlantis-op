# Mounted at /etc/atlantis/atlantis.env.op. Dotenv format: values may be
# op://<vault>/<item>/<field> references (resolved at startup) or plain values.

# --- Atlantis server ---------------------------------------------------------
ATLANTIS_GH_USER=my-github-user
ATLANTIS_GH_TOKEN=op://Atlantis/GitHub/token
ATLANTIS_GH_WEBHOOK_SECRET=op://Atlantis/GitHub/webhook_secret
ATLANTIS_REPO_ALLOWLIST=github.com/my-github-user/my-infra-repo

# --- Terraform backend credentials -------------------------------------------
# Terraform backends can't read from providers, so their credentials come from env.
# Example: S3 / Cloudflare R2.
AWS_ACCESS_KEY_ID=op://Atlantis/Terraform State/access_key_id
AWS_SECRET_ACCESS_KEY=op://Atlantis/Terraform State/secret_access_key
# AWS_ENDPOINT_URL_S3=op://Atlantis/Terraform State/endpoint
